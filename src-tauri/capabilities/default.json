{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capabilities for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:webview:allow-internal-toggle-devtools",
    "shell:allow-open",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "mcp-stdio",
          "cmd": ".*",
          "args": true,
          "sidecar": false
        }
      ]
    },
    "dialog:allow-open",
    "dialog:allow-save",
    "opener:allow-reveal-item-in-dir",
    "opener:default",
    {
      "identifier": "opener:allow-open-path",
      "allow": [
        {
          "path": "**"
        }
      ]
    },
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://canvas.lingecho.com/*"
        },
        {
          "url": "https://simplefuture.zone/*"
        },
        {
          "url": "https://canvas.soulmy.top/*"
        }
      ]
    },
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "https://cdn.jsdelivr.net/*"
        },
        {
          "url": "http://localhost:*/*"
        },
        {
          "url": "http://127.0.0.1:*/*"
        },
        {
          "url": "https://localhost:*/*"
        },
        {
          "url": "https://127.0.0.1:*/*"
        },
        {
          "url": "http://1.14.99.158:9000/*"
        },
        {
          "url": "https://canvas.lingecho.com/*"
        },
        {
          "url": "https://simplefuture.zone/*"
        },
        {
          "url": "https://*.simplefuture.zone/*"
        },
        {
          "url": "https://canvas.soulmy.top/*"
        },
        {
          "url": "https://*.soulmy.top/*"
        },
        {
          "url": "https://*.lingecho.com/*"
        },
        {
          "url": "https://*.zhongzhuan.chat/*"
        },
        {
          "url": "https://*.amazonaws.com/*"
        },
        {
          "url": "https://*.amazonaws.com.cn/*"
        },
        {
          "url": "https://*.myqcloud.com/*"
        },
        {
          "url": "https://*.aliyuncs.com/*"
        },
        {
          "url": "https://*.aliyun.com/*"
        },
        {
          "url": "https://*.qiniucs.com/*"
        },
        {
          "url": "https://*.qiniu.com/*"
        },
        {
          "url": "https://*.qiniudn.com/*"
        },
        {
          "url": "https://*.volces.com/*"
        },
        {
          "url": "https://*.volcengineapi.com/*"
        },
        {
          "url": "https://*.myhuaweicloud.com/*"
        },
        {
          "url": "https://*.huaweicloud.com/*"
        },
        {
          "url": "https://*.ksyun.com/*"
        },
        {
          "url": "https://*.ksyuncs.com/*"
        },
        {
          "url": "http://*/*"
        },
        {
          "url": "https://*/*"
        }
      ]
    },
    "fs:allow-read-file",
    "fs:allow-read-text-file",
    "fs:allow-write-file",
    "fs:allow-write-text-file",
    "fs:allow-read-dir",
    "fs:allow-mkdir",
    "fs:allow-remove",
    "fs:allow-exists",
    "fs:allow-stat",
    "fs:allow-copy-file",
    "fs:allow-rename",
    {
      "identifier": "fs:scope",
      "allow": [
        "**",
        "**/.*",
        "**/.*/**"
      ]
    },
    "updater:default",
    "process:default",
    "clipboard-manager:allow-read-image",
    "clipboard-manager:allow-read-text",
    "clipboard-manager:allow-write-text",
    "clipboard-manager:allow-write-image"
  ]
}
