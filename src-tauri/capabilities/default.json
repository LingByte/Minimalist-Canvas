{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capabilities for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:webview:allow-internal-toggle-devtools",
    "shell:allow-open",
    "dialog:allow-open",
    "dialog:allow-save",
    "opener:allow-reveal-item-in-dir",
    "opener:default",
    {
      "identifier": "opener:allow-open-path",
      "allow": [
        { "path": "**" }
      ]
    },
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://cdn.jsdelivr.net/*" },
        { "url": "http://localhost:3000/*" },
        { "url": "http://127.0.0.1:3000/*" },
        { "url": "http://1.14.99.158:9000/*" },
        { "url": "https://canvas.lingecho.com/*" },
        { "url": "https://simplefuture.zone/*" },
        { "url": "https://*.simplefuture.zone/*" },
        { "url": "https://*.lingecho.com/*" },
        { "url": "https://*.zhongzhuan.chat/*" }
      ]
    },
    "fs:allow-read-file",
    "fs:allow-read-text-file",
    "fs:allow-write-file",
    "fs:allow-write-text-file",
    "fs:allow-read-dir",
    "fs:allow-mkdir",
    "fs:allow-remove",
    "fs:allow-exists",
    "fs:allow-stat",
    "fs:allow-copy-file",
    "fs:allow-rename",
    {
      "identifier": "fs:scope",
      "allow": [
        "**",
        "**/.*",
        "**/.*/**"
      ]
    }
  ]
}
