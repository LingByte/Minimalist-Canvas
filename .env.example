# Frontend (Rsbuild) — put this file as .env or .env.local
# Only VITE_* variables are exposed to the browser bundle.

# API server URL used by the desktop app
# VITE_REACT_APP_SERVER_URL=http://localhost:3000

# Demo login: replace header "Sign in" with "Enter Console" and
# auto-login (default admin / admin123) without opening the sign-in dialog.
# VITE_DEMO_LOGIN_ENABLED=true
# VITE_DEMO_LOGIN_USERNAME=admin
# VITE_DEMO_LOGIN_PASSWORD=admin123
